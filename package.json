{
  "name": "signalmode",
  "version": "2.1.0",
  "description": "SignalMode — Signal over noise. LLM-agnostic communication optimizer for AI coding agents.",
  "license": "MIT",
  "author": "wfprieto",
  "homepage": "https://github.com/wfprieto/SignalMode",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wfprieto/SignalMode.git"
  },
  "bugs": {
    "url": "https://github.com/wfprieto/SignalMode/issues"
  },
  "type": "module",
  "bin": {
    "signalmode": "./bin/install.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate": "node scripts/generate-platforms.js",
    "validate": "node scripts/validate-repository.js",
    "lint": "node scripts/lint-prompts.js",
    "test": "node --test tests/installer/*.test.mjs tests/policies/*.test.mjs",
    "test:installer": "node --test tests/installer/*.test.mjs",
    "test:policies": "node --test tests/policies/*.test.mjs",
    "check": "npm run validate && npm run lint",
    "precommit": "npm run check",
    "ci": "npm run check && npm test"
  },
  "files": [
    "bin/",
    "src/",
    "agents/",
    "skills/",
    "platforms/",
    "rules/",
    "scripts/",
    "commands/",
    "README.md",
    "LICENSE",
    "INSTALL.md"
  ]
}
